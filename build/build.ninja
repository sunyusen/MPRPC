build example/caller/rebuild_cache: phony example/caller/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for edit_cache

build example/caller/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/glf/MPRPC/build/example/caller && /usr/bin/cmake3 -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build example/caller/edit_cache: phony example/caller/CMakeFiles/edit_cache.util


#############################################
# Utility command for test

build example/caller/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/glf/MPRPC/build/example/caller && /usr/bin/ctest3 --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build example/caller/test: phony example/caller/CMakeFiles/test.util

# =============================================================================
# Object build statements for EXECUTABLE target consumer


#############################################
# Order-only phony target for consumer

build cmake_object_order_depends_target_consumer: phony || cmake_object_order_depends_target_mprpc

build example/caller/CMakeFiles/consumer.dir/callfriendsservice.cc.o: CXX_COMPILER__consumer_Debug ../example/caller/callfriendsservice.cc || cmake_object_order_depends_target_consumer
  DEP_FILE = example/caller/CMakeFiles/consumer.dir/callfriendsservice.cc.o.d
  FLAGS = -std=c++11 -gdwarf-4 -g   -std=gnu++14
  INCLUDES = -I../src/include -I../example -I/usr/local/protobuf/include
  OBJECT_DIR = example/caller/CMakeFiles/consumer.dir
  OBJECT_FILE_DIR = example/caller/CMakeFiles/consumer.dir

build example/caller/CMakeFiles/consumer.dir/__/friend.pb.cc.o: CXX_COMPILER__consumer_Debug ../example/friend.pb.cc || cmake_object_order_depends_target_consumer
  DEP_FILE = example/caller/CMakeFiles/consumer.dir/__/friend.pb.cc.o.d
  FLAGS = -std=c++11 -gdwarf-4 -g   -std=gnu++14
  INCLUDES = -I../src/include -I../example -I/usr/local/protobuf/include
  OBJECT_DIR = example/caller/CMakeFiles/consumer.dir
  OBJECT_FILE_DIR = example/caller/CMakeFiles/consumer.dir/__


# =============================================================================
# Link build statements for EXECUTABLE target consumer


#############################################
# Link the executable ../bin/consumer

build ../bin/consumer: CXX_EXECUTABLE_LINKER__consumer_Debug example/caller/CMakeFiles/consumer.dir/callfriendsservice.cc.o example/caller/CMakeFiles/consumer.dir/__/friend.pb.cc.o | ../lib/libmprpc.a || ../lib/libmprpc.a
  FLAGS = -std=c++11 -gdwarf-4 -g
  LINK_FLAGS = -rdynamic
  LINK_LIBRARIES = -Wl,-rpath,/home/glf/MPRPC/lib:/usr/local/protobuf/lib  ../lib/libmprpc.a  -lprotobuf  -lmuduo_net  -lmuduo_base  -lpthread  -lzookeeper_mt
  LINK_PATH = -L/home/glf/MPRPC/lib   -L/usr/local/protobuf/lib
  OBJECT_DIR = example/caller/CMakeFiles/consumer.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = ../bin/consumer
  TARGET_PDB = consumer.dbg

